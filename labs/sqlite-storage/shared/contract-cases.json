    {
      "id": "upgrade-v1-preserves-data",
      "steps": [
        {
          "sql": "CREATE TABLE progress (\n  id INTEGER PRIMARY KEY,\n  owner_id TEXT NOT NULL,\n  lesson_id TEXT NOT NULL,\n  completed INTEGER NOT NULL CHECK (completed IN (0, 1)),\n  created_at TEXT NOT NULL,\n  UNIQUE (owner_id, lesson_id)\n);\nCREATE TABLE audit (\n  id INTEGER PRIMARY KEY,\n  progress_id INTEGER NOT NULL REFERENCES progress(id),\n  completed INTEGER NOT NULL CHECK (completed IN (0, 1)),\n  at TEXT NOT NULL\n);\nCREATE INDEX audit_progress_id ON audit(progress_id, id);\n\nINSERT INTO progress(id,owner_id,lesson_id,completed,created_at) VALUES(8,'alice','legacy',1,'2026-10-03T12:00:00.000Z');\nINSERT INTO audit(id,progress_id,completed,at) VALUES(4,8,1,'2026-10-03T12:00:00.000Z');\nPRAGMA user_version=1;"
        },
        {
          "request": {
            "op": "list_progress",
            "owner_id": "alice",
            "cursor": 0,
            "limit": 20
          },
          "expected": {
            "error": "unsupported_schema"
          },
          "exit_code": 1
        },
        {
          "request": {
            "op": "migrate"
          },
          "expected": {
            "schema_version": 2
          },
          "exit_code": 0
        },
        {
          "request": {
            "op": "migrate"
          },
          "expected": {
            "schema_version": 2
          },
          "exit_code": 0
        },
        {
          "request": {
            "op": "list_progress",
            "owner_id": "alice",
            "cursor": 0,
            "limit": 20
          },
          "expected": {
            "items": [
              {
                "id": 8,
                "owner_id": "alice",
                "lesson_id": "legacy",
                "completed": true,
                "created_at": "2026-10-03T12:00:00.000Z",
                "updated_at": "2026-10-03T12:00:00.000Z"
              }
            ],
            "next_cursor": null
          },
          "exit_code": 0
        },
        {
          "request": {
            "op": "list_audit",
            "owner_id": "alice",
            "cursor": 0,
            "limit": 20
          },
          "expected": {
            "items": [
              {
                "id": 4,
                "progress_id": 8,
                "completed": true,
                "at": "2026-10-03T12:00:00.000Z"
              }
            ],
            "next_cursor": null
          },
          "exit_code": 0
        },
        {
          "request": {
            "op": "set_progress",
            "owner_id": "alice",
            "lesson_id": "new",
            "completed": false,
            "at": "2026-10-03T12:01:00.000Z"
          },
          "expected": {
            "item": {
              "id": 9,
              "owner_id": "alice",
              "lesson_id": "new",
              "completed": false,
              "created_at": "2026-10-03T12:01:00.000Z",
              "updated_at": "2026-10-03T12:01:00.000Z"
            },
            "changed": true
          },
          "exit_code": 0
        }
      ]
    },
    {
