{
  "name": "api-navigation-course-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5199 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 5199 --strictPort",
    "build": "tsc --noEmit && vite build",
    "format:check": "prettier --check src *.ts *.json *.html pnpm-lock.yaml",
    "test": "vitest run src/*.test.ts",
    "check": "pnpm format:check && pnpm test && pnpm build"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "jotai": "2.20.3",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "24.19.1",
    "@vitejs/plugin-react": "5.2.0",
    "vite": "7.3.6",
    "typescript": "5.9.3",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "prettier": "3.9.9",
    "vitest": "4.1.11"
  }
}
