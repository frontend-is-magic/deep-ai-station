{
  "name": "deep-ai-station",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "uv run uvicorn backend.app:app --host 127.0.0.1 --port 8000 --reload",
    "build": "tsc -b && vite build",
    "vercel-build": "pnpm build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src tests docs scripts/*.mjs *.json *.md *.ts *.html .github",
    "format:check": "prettier --check src tests docs scripts/*.mjs *.json *.md *.ts *.html .github",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm test && pnpm build",
    "test:e2e": "uv run pytest -m e2e"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jotai": "^2.15.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "hono": "4.13.12",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
