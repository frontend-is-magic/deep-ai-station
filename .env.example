# 服务端配置；不得使用 VITE_ 前缀存储密钥。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# 启用真实模型必须同时设置访问码。请在托管 secrets 中配置。
PLAYGROUND_ACCESS_TOKEN=
# 可选隔离运行；API_KEY 仅用于服务端连接，绝不注入用户沙箱。
E2B_API_KEY=
# Go 使用预装 Go 编译器和所需依赖的 E2B code-interpreter 模板。
E2B_GO_TEMPLATE=
