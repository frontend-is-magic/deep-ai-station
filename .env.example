# 服务端配置；不得使用 VITE_ 前缀存储密钥。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# 启用真实模型需要访问码与共享请求配额。请在托管 secrets 中配置。
PLAYGROUND_ACCESS_TOKEN=
# 可选隔离运行；API_KEY 仅用于服务端连接，绝不注入用户沙箱。
E2B_API_KEY=
# Go 使用预装 Go 编译器和所需依赖的 E2B code-interpreter 模板。
E2B_GO_TEMPLATE=

# 默认 postgres。连接串仅在服务端托管；初始化配额与账本步骤见 docs/shared-quota.md / docs/model-usage.md。
AI_QUOTA_MODE=postgres
AI_QUOTA_DATABASE_URL=
AI_QUOTA_SCOPE=deep-ai-station
# 仅独立本地调试可显式使用 memory；VERCEL=1 / APP_ENV=production 禁止。
